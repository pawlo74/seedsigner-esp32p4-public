 static const char *TAG = "display_manager";
 
+/* This watchdog is independent of the screensaver and the Python VM/GIL. LVGL
+ * input events update an ESP monotonic timestamp. Programmatic LVGL activity
+ * (e.g. dismissing the screensaver) cannot extend a secret-bearing session. */
+static portMUX_TYPE s_session_idle_lock = portMUX_INITIALIZER_UNLOCKED;
+static session_idle_policy_t s_session_idle = {0, 30 * 60 * 1000, false, false};
+
+static uint64_t session_now_ms(void)
+{
+    return (uint64_t)esp_timer_get_time() / 1000;
+}
+
+static void session_idle_input_cb(lv_event_t *e)
+{
+    lv_event_code_t code = lv_event_get_code(e);
+    if (code != LV_EVENT_PRESSED && code != LV_EVENT_RELEASED && code != LV_EVENT_CLICKED &&
+        code != LV_EVENT_LONG_PRESSED_REPEAT && code != LV_EVENT_KEY &&
+        code != LV_EVENT_ROTARY) return;
+    uint64_t now = session_now_ms();
+    portENTER_CRITICAL(&s_session_idle_lock);
+    session_idle_activity(&s_session_idle, now);
+    portEXIT_CRITICAL(&s_session_idle_lock);
+}
+
+static void session_idle_watchdog(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(250));
+        /* A held touch/key remains activity even when LVGL emits no repeated
+         * indev event. Taking this lock does not depend on the Python GIL. */
+        if (lvgl_port_lock(10)) {
+            for (lv_indev_t *indev = lv_indev_get_next(NULL); indev; indev = lv_indev_get_next(indev)) {
+                if (lv_indev_get_state(indev) == LV_INDEV_STATE_PRESSED) {
+                    uint64_t activity = session_now_ms();
+                    portENTER_CRITICAL(&s_session_idle_lock);
+                    session_idle_activity(&s_session_idle, activity);
+                    portEXIT_CRITICAL(&s_session_idle_lock);
+                    break;
+                }
+            }
+            lvgl_port_unlock();
+        }
+        uint64_t now = session_now_ms();
+        portENTER_CRITICAL(&s_session_idle_lock);
+        bool expired = session_idle_expired(&s_session_idle, now);
+        portEXIT_CRITICAL(&s_session_idle_lock);
+        if (expired) {
+            ESP_LOGW(TAG, "Seed session idle timeout: restarting device");
+            esp_restart();
+        }
+    }
+}
+
+extern "C" void dm_session_idle_arm(void)
+{
+    uint64_t now = session_now_ms();
+    portENTER_CRITICAL(&s_session_idle_lock);
+    session_idle_arm(&s_session_idle, now);
+    portEXIT_CRITICAL(&s_session_idle_lock);
+}
+
+extern "C" void dm_session_idle_set_timeout(uint32_t ms)
+{
+    uint64_t now = session_now_ms();
+    portENTER_CRITICAL(&s_session_idle_lock);
+    session_idle_set_timeout(&s_session_idle, ms, now);
+    portEXIT_CRITICAL(&s_session_idle_lock);
+}
+
+extern "C" void dm_session_idle_set_paused(bool paused)
+{
+    uint64_t now = session_now_ms();
+    portENTER_CRITICAL(&s_session_idle_lock);
+    session_idle_set_paused(&s_session_idle, paused, now);
+    portEXIT_CRITICAL(&s_session_idle_lock);
+}
